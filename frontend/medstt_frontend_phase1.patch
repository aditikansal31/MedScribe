+.pageHeader{display:flex;justify-content:space-between;gap:1rem;align-items:flex-start;margin-bottom:1.5rem}
+.eyebrow{text-transform:uppercase;letter-spacing:.08em;font-size:.72rem;font-weight:700;color:var(--color-text-secondary)}
+.title{font-size:1.75rem;margin-top:.25rem}.subtitle{color:var(--color-text-secondary);margin:.4rem 0 0}
+.grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1rem;margin-bottom:1rem}
+.card{background:var(--color-surface);border:1px solid var(--color-border);border-radius:var(--radius-md);padding:1.1rem;box-shadow:var(--shadow-sm)}
+.card h2{font-size:1rem;margin-bottom:.8rem}.wide{grid-column:1/-1}
+.stat{font-size:1.5rem;font-weight:700}.muted{color:var(--color-text-secondary);font-size:.85rem}
+.row{display:flex;gap:.65rem;align-items:center;flex-wrap:wrap}
+.field{display:flex;flex-direction:column;gap:.3rem}.field label{font-size:.8rem;font-weight:600;color:var(--color-text-secondary)}
+.input,.select,.textarea{width:100%;border:1px solid var(--color-border);border-radius:var(--radius-sm);padding:.65rem .7rem;background:#fff;color:var(--color-text)}
+.textarea{min-height:100px;resize:vertical}
+.formGrid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.85rem}.full{grid-column:1/-1}
+.button{border:1px solid var(--color-primary);background:var(--color-primary);color:#fff;border-radius:var(--radius-sm);padding:.62rem .85rem;font-weight:600}
+.button:hover{background:var(--color-primary-hover)}.button:disabled{opacity:.5;cursor:not-allowed}
+.secondary{background:#fff;color:var(--color-text);border-color:var(--color-border)}
+.danger{background:#fff;color:var(--color-error);border-color:#e5b6b3}
+.error{background:var(--color-error-bg);color:var(--color-error);border:1px solid #efc5c2;border-radius:var(--radius-sm);padding:.75rem;margin-bottom:1rem}
+.success{background:#eef7f4;color:var(--color-success);border:1px solid #c6e1d9;border-radius:var(--radius-sm);padding:.75rem;margin-bottom:1rem}
+.steps{display:flex;gap:.4rem;overflow:auto;padding-bottom:.2rem;margin-bottom:1rem}.step{padding:.45rem .7rem;border-radius:999px;background:#eef1f4;color:var(--color-text-secondary);font-size:.78rem;white-space:nowrap}.stepDone{background:#e6f2ee;color:var(--color-success)}.stepActive{background:#e8eef5;color:var(--color-primary);font-weight:700}
+.drop{border:1px dashed #aeb8c2;border-radius:var(--radius-md);padding:1.3rem;text-align:center;background:#fbfcfd}.drop input{max-width:100%}
+.status{display:inline-flex;align-items:center;gap:.4rem;padding:.3rem .55rem;border-radius:999px;background:#eef1f4;font-size:.75rem;font-weight:600}
+.kv{display:grid;grid-template-columns:180px 1fr;border-top:1px solid var(--color-border)}.kv div{padding:.55rem 0;border-bottom:1px solid var(--color-border)}.kv div:nth-child(odd){font-weight:600;color:var(--color-text-secondary)}
+.transcript{white-space:pre-wrap;background:#f8fafb;border:1px solid var(--color-border);padding:.8rem;border-radius:var(--radius-sm);max-height:280px;overflow:auto;font-size:.88rem}
+.entity{display:inline-flex;gap:.35rem;border:1px solid var(--color-border);padding:.3rem .45rem;border-radius:999px;margin:.2rem;font-size:.78rem}.entity small{color:var(--color-text-secondary)}
+.medRow{display:grid;grid-template-columns:1.2fr 1fr 1fr 1fr 1.5fr auto;gap:.5rem;margin-bottom:.55rem}
+.notice{font-size:.82rem;color:var(--color-text-secondary);background:#f6f8fa;border-radius:var(--radius-sm);padding:.7rem}
+@media(max-width:900px){.grid{grid-template-columns:1fr}.formGrid{grid-template-columns:1fr}.medRow{grid-template-columns:1fr}.pageHeader{flex-direction:column}}
